# ==========================================
# TRADING BOT ENVIRONMENT CONFIGURATION
# ==========================================

# Execution Mode: PAPER (default, simulated) or LIVE (real orders)
EXECUTION_MODE="PAPER"
LOG_LEVEL="info"

# Discord Webhook for Automated Trade & Risk Alerts
DISCORD_WEBHOOK_URL=""

# Exchange Credentials (Optional for public paper trading)
EXCHANGE_API_KEY=""
EXCHANGE_API_SECRET=""
BYBIT_HOSTNAME="bytick.com"

# Account & Trading Capital
INITIAL_CAPITAL=10000
TIMEFRAME="1h"

# ==========================================
# STRATEGY PARAMETERS (Trend Following + Momentum)
# ==========================================
STRATEGY_FAST_EMA=20
STRATEGY_SLOW_EMA=50
STRATEGY_RSI_PERIOD=14
STRATEGY_LONG_RSI_MIN=40
STRATEGY_LONG_RSI_MAX=65
STRATEGY_SHORT_RSI_MIN=35
STRATEGY_SHORT_RSI_MAX=60
STRATEGY_ADX_PERIOD=14
STRATEGY_ADX_THRESHOLD=25
STRATEGY_ATR_PERIOD=14
STRATEGY_ATR_MULTIPLIER=2.8
ATR_TRAILING_MULTIPLIER=2.8
STRATEGY_TRAILING_STOP_MODE="intrabar"
STRATEGY_TP_R_MULTIPLIER=0

# ==========================================
# RISK MANAGEMENT & POSITION SIZING
# ==========================================
RISK_MAX_PCT=0.02
RISK_MAX_DRAWDOWN_PCT=0.05
RISK_LOCKOUT_MS=86400000
RISK_SIZING_MODE="fixed" # "fixed" or "kelly"
RISK_KELLY_FRACTION=0.5
RISK_KELLY_WIN_RATE=0.55
RISK_KELLY_REWARD_RATIO=1.5

# Execution Friction Models
TAKER_FEE=0.00075
SLIPPAGE=0.0005

# ==========================================
# 15-COIN WATCHLIST & PORTFOLIO HEAT GUARDS
# ==========================================
PINNED_CORE_PAIRS='["BTC/USDT", "ETH/USDT", "SOL/USDT", "SUI/USDT", "XRP/USDT", "DOGE/USDT", "1000PEPE/USDT"]'
DYNAMIC_SCREENER_SLOTS=5
MAX_CONCURRENT_POSITIONS=8
MAX_SAME_DIRECTION_POSITIONS=4
SCREENING_INTERVAL_HOURS=6
DEFAULT_USD_NGN_RATE=1650

# ==========================================
# FOREX / OANDA CREDENTIALS (Disabled by default)
# ==========================================
FOREX_ENABLED=false
OANDA_API_KEY=""
OANDA_ACCOUNT_ID=""

# ==========================================
# TRADE W MT4/MT5 EXECUTION ENVIRONMENT
# ==========================================
# Option A: metaapi.cloud SDK cloud bridge
TRADEW_METAAPI_TOKEN=""
TRADEW_ACCOUNT_ID=""
TRADEW_SERVER="TradeW-Live"
TRADEW_PLATFORM="MT5"
TRADEW_TARGET_SYMBOL="ETC/USDT"
TRADEW_MT5_SYMBOL="ETCUSDT"

# Option B: Local ZeroMQ Expert Advisor Bridge
TRADEW_ZMQ_URL="tcp://127.0.0.1:5555"

# ==========================================
# DASHBOARD & OPERATOR API AUTHENTICATION
# ==========================================
CONTROL_API_KEY="dev_operator_key_change_in_production"
NEXT_PUBLIC_CONTROL_API_KEY="dev_operator_key_change_in_production"