# ==========================================
# BYBIT MARKET DATA RECORDER CONFIGURATION
# ==========================================

# Logging verbosity: info, debug, warn, error
LOG_LEVEL="info"

# Database storage path (defaults to data/recorder.db in WAL mode)
RECORDER_DB_PATH="data/recorder.db"

# Public Bybit Endpoints (No API keys or credentials required)
BYBIT_PRIMARY_REST="https://api.bybit.com"
BYBIT_FALLBACK_REST="https://api.bytick.com"
BYBIT_PRIMARY_WS="wss://stream.bybit.com/v5/public/linear"
BYBIT_FALLBACK_WS="wss://stream.bytick.com/v5/public/linear"

# Dead-Man's Switch Heartbeat URL (e.g. healthchecks.io free tier ping)
HEALTHCHECK_URL=""

# Optional Discord Webhook for system outages & daily reports
DISCORD_WEBHOOK_URL=""
