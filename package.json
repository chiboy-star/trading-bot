{
  "name": "bybit-market-data-recorder",
  "version": "1.0.0",
  "main": "dist/src/recorder/index.js",
  "scripts": {
    "build": "tsc",
    "recorder": "node dist/src/recorder/index.js",
    "recorder:dry-run": "node dist/src/recorder/index.js --dry-run",
    "recorder:report": "node dist/src/recorder/index.js --report",
    "recorder:backup": "node dist/scripts/backup_recorder.js",
    "dashboard:dev": "npm run dev --prefix dashboard",
    "dashboard:build": "npm run build --prefix dashboard",
    "dashboard:start": "npm run start --prefix dashboard",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "bybit",
    "market-data",
    "recorder",
    "cryptocurrency",
    "high-frequency"
  ],
  "author": "",
  "license": "ISC",
  "description": "High-frequency Bybit market data recorder capturing unbiased forward order books, liquidations, klines, and funding rates",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.4",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "undici": "^7.19.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
